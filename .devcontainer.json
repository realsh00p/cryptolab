{
    "name": "cryptolab-python",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    "postCreateCommand": "python -m venv --clear py/.venv && py/.venv/bin/python -m pip install --upgrade pip && py/.venv/bin/python -m pip install --editable './py[dev]' && cmake --preset dev -S cpp",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${workspaceFolder}/py/.venv/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.fixAll.ruff": "explicit",
                        "source.organizeImports.ruff": "explicit"
                    }
                },
                "rust-analyzer.linkedProjects": [
                    "${workspaceFolder}/rs/Cargo.toml"
                ],
                "clangd.path": "clangd",
                "clangd.arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--compile-commands-dir=${workspaceFolder}/cpp/build"
                ],
                "cmake.sourceDirectory": "${workspaceFolder}/cpp",
                "cmake.buildDirectory": "${workspaceFolder}/cpp/build",
                "cmake.generator": "Ninja"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "rust-lang.rust-analyzer",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
